{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_USE_POWERSHELL_TOOL": "1"
  },
  "permissions": {
    "allow": [
      "WebSearch",
      "mcp__ping__*",
      "mcp__pong__*",
      "WebFetch(domain:www.port.io)",
      "WebFetch(domain:www.cncf.io)",
      "WebFetch(domain:backstage.io)"
    ],
    "defaultMode": "dontAsk"
  },
  "skillOverrides": {
    "Agent": "off",
    "EnterPlanMode": "off",
    "ExitPlanMode": "off",
    "ExitWorktree": "off",
    "EnterWorktree": "off",
    "WebFetch": "off",
    "WebSearch": "off",
    "Monitor": "off",
    "CronCreate": "off",
    "CronDelete": "off",
    "CronList": "off",
    "RemoteTrigger": "off",
    "ScheduleWakeup": "off",
    "Skill": "off"
  },
  "statusLine": {
    "type": "command",
    "command": "uv run  ~/.claude/statusline.py"
  },
  "enabledPlugins": {
    "skill-creator@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "dgxsparklabs-marketplace": {
      "source": {
        "source": "directory",
        "path": "C:\\Users\\devic\\source\\marketplace"
      }
    }
  },
  "outputStyle": "Explanatory",
  "viewMode": "verbose",
  "effortLevel": "low",
  "autoUpdatesChannel": "latest",
  "tui": "fullscreen",
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "autoMemoryEnabled": false,
  "showThinkingSummaries": true,
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark",
  "editorMode": "normal",
  "verbose": true,
  "autoCompactEnabled": false,
  "fileCheckpointingEnabled": true,
  "showTurnDuration": true,
  "showMessageTimestamps": true,
  "remoteControlAtStartup": true,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true,
  "voiceEnabled": true
}
